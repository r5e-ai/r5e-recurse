{
  "group": "recurse.r5e.io",
  "version": "v1alpha1",
  "kind": "PolicyBundle",
  "substrate": "resource",
  "naming": {
    "mode": "literal",
    "value": "active",
    "readmitBy": "actorOfRecordOrSuccessor"
  },
  "description": "The recorded actor submitted this PolicyBundle under the cited authority; operational claims remain scoped to the recorded evidence.",
  "schema": {
    "properties": {
      "engine": {
        "type": "string",
        "enum": [
          "cedar"
        ]
      },
      "sourceRef": {
        "type": "ref",
        "ref": {
          "bytes": true,
          "retention": "public-record"
        }
      },
      "governs": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "recurse.r5e.io/v1alpha1/Graph",
            "recurse.r5e.io/v1alpha1/Node",
            "recurse.r5e.io/v1alpha1/Task",
            "recurse.r5e.io/v1alpha1/SessionBinding",
            "recurse.r5e.io/v1alpha1/ContextManifest",
            "recurse.r5e.io/v1alpha1/Artifact",
            "recurse.r5e.io/v1alpha1/LifecycleEvent",
            "recurse.r5e.io/v1alpha1/Command",
            "recurse.r5e.io/v1alpha1/Review",
            "recurse.r5e.io/v1alpha1/Decision",
            "recurse.r5e.io/v1alpha1/RecoveryDecision",
            "recurse.r5e.io/v1alpha1/ReconciliationObservation",
            "recurse.r5e.io/v1alpha1/ManagedRequest",
            "recurse.r5e.io/v1alpha1/ActionResult",
            "recurse.r5e.io/v1alpha1/LessonWithdrawal"
          ]
        }
      }
    },
    "required": [
      "engine",
      "sourceRef",
      "governs"
    ],
    "additionalProperties": false,
    "nonEmpty": [
      "governs"
    ]
  },
  "requiresAuthority": true,
  "epistemicScope": {
    "claims": [
      "The recorded actor admitted these PolicyBundle fields at this chain position under the resolved authority.",
      "Scope is an explicit list of governed Kind paths excluding policy-management acts; upstream policy decides replacement."
    ],
    "doesNotClaim": [
      "That descriptive fields prove model authorship, identity beyond the signing key, or events outside the recorded path.",
      "That schema acceptance proves application workflow constraints or external execution."
    ]
  },
  "predicates": []
}
